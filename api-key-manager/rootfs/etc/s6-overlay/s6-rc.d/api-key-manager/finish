#!/bin/sh
# Called by s6 when the app exits. Stop the whole container with the app's exit
# code so Supervisor sees the real status (and its watchdog can restart it),
# instead of s6 silently restarting a crashed process in a loop.
exit_code="$1"
if [ "$exit_code" -eq 256 ]; then
  exit_code=$((128 + $2))
fi
echo "$exit_code" > /run/s6-linux-init-container-results/exitcode
exec /run/s6/basedir/bin/halt
